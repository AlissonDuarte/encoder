DB_TYPE="postgres"
DSN="dbname=encoder sslmode=disable user=postgres password=root host=db"
DB_TYPE_TEST="sqlite3"
DSN_TEST=":memory:"
ENV="dev"
DEBUG=true
AUTO_MIGRATE_DB=true
localStoragePath="/tmp"
outputBucketName="encoded-bucket-go-lang"
inputBucketName="encoded-bucket-go-lang"
GOOGLE_APPLICATION_CREDENTIALS="/go/src/bucket-credential.json"
CONCURRENCY=2
CONCURRENCY_UPLOAD=10

RABBIT_DEFAULT_USER=rabbitmq
RABBIT_DEFAULT_PASSWORD=rabbitmq
RABBIT_DEFAULT_HOST=rabbit
RABBIT_DEFAULT_PORT=5672
RABBIT_DEFAULT_VHOST=/
RABBIT_CONSUMER_NAME=app-name
RABBIT_CONSUMER_QUEUE_NAME=videos
RABBIT_NOTIFICATION_EX=amq.direct
RABBIT_NOTIFICATION_ROUTING_KEY=jobs
RABBIT_DLX=dlx
